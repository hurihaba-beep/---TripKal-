# ---- Duffel (required for real flight search) ----
# developers.duffel.com — create an app, start in "test mode" (fake bookable
# data, safe for development), switch to a live token later for real prices.
DUFFEL_TOKEN=duffel_test_xxx

# ---- Travelpayouts / Aviasales (price verification + affiliate marker) ----
# app.travelpayouts.com — free account, used for the cached "cheap prices"
# lookup that the frontend shows as "מאומת ✓".
TRAVELPAYOUTS_TOKEN=

# ---- Apify (optional — powers /api/live-price's Google Flights / Kiwi check) ----
# Only needed for the "בדוק מחיר עדכני" button on stale/unverified results.
# Without this, /api/live-price returns 503 and the frontend just keeps the
# button clickable to retry, which is the behavior it already expects.
APIFY_TOKEN=
APIFY_ACTOR_ID=

# ---- Supabase (required for /api/subscribe email alerts) ----
# supabase.com — needs a "subscribers" table, see README section in server.js
# comments for the exact columns expected.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- Anthropic (powers the on-demand "מה הכי כדאי?" AI summary button) ----
# console.anthropic.com -> API Keys -> create key. Billed per request; safe
# here because the button that triggers it is on-demand, not automatic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Misc ----
PORT=3000
